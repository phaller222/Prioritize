# Copy to .env and adjust. docker compose reads .env automatically.

# PostgreSQL password (used by both the db and the app service).
DB_PASSWORD=prioritize

# Active Spring profiles for the app. Default: postgres.
# Add the optional stacks when you start them with their compose profile, e.g.:
#   docker compose --profile mqtt up      -> SPRING_PROFILES_ACTIVE=postgres,mqtt
#   docker compose --profile keycloak up  -> SPRING_PROFILES_ACTIVE=postgres,keycloak
SPRING_PROFILES_ACTIVE=postgres
